{
  "name": "workbench",
  "productName": "Workbench",
  "version": "0.1.0",
  "description": "Workspace desktop app: templated workspaces with an embedded browser, terminal and task descriptor",
  "author": "Timothy Day <tday141@gmail.com>",
  "license": "GPL-2.0-only",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "electron-rebuild -f -w node-pty",
    "fetch-ublock": "node scripts/fetch-ublock.mjs",
    "dist": "electron-vite build && electron-builder --linux deb AppImage",
    "install-local": "electron-vite build && electron-builder --linux dir && bash scripts/install-local.sh",
    "fmt": "prettier --write \"src/**/*.{ts,css,html}\" \"scripts/*.mjs\" vendor/ublock-shim.js electron.vite.config.ts",
    "fmt-check": "prettier --check \"src/**/*.{ts,css,html}\" \"scripts/*.mjs\" vendor/ublock-shim.js electron.vite.config.ts"
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "printWidth": 100,
    "trailingComma": "none",
    "overrides": [
      {
        "files": [
          "*.css",
          "*.html"
        ],
        "options": {
          "tabWidth": 4
        }
      }
    ]
  },
  "build": {
    "appId": "dev.timothy.workbench",
    "productName": "Workbench",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "templates",
        "to": "templates"
      },
      {
        "from": "vendor/ublock",
        "to": "vendor/ublock"
      }
    ],
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "executableName": "workbench",
      "desktop": {
        "entry": {
          "StartupWMClass": "workbench"
        }
      }
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^26.6.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
