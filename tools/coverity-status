#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-only
#
# Scrape the public Coverity Scan project page into coverity_status.json
# for the status site.
#
# The project page (https://scan.coverity.com/projects/<name>) is public
# and needs no login, but only gives the age of the last analyzed build
# as a phrase ("about 2 months ago"); exact build dates are behind the
# login-only builds list. The phrase is recorded verbatim along with
# when it was fetched.
#
#   ./tools/coverity-status --output /var/www/ci-lustre/upstream-patch-review
#

import argparse
import html
import json
import os
import re
import sys
import time
import urllib.error
import urllib.request

COVERITY_SCAN = "https://scan.coverity.com"

# Rows of the "general-info" table on the project page, keyed by the
# name used in coverity_status.json
FIELDS = {
    "last_build_analyzed": "Last build analyzed",
    "lines_of_code": "Lines of code analyzed",
    "on_scan_since": "On Coverity Scan since",
}


def fetch_project_page(project, timeout):
    url = f"{COVERITY_SCAN}/projects/{project}"
    # The site serves an error page to the default urllib agent
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 ktest"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return url, resp.read().decode("utf-8", errors="replace")


def parse_fields(page):
    """Pull the FIELDS rows out of the project page's stats table."""
    found = {}

    for key, label in FIELDS.items():
        match = re.search(
            r"<th>\s*" + re.escape(label) + r"\s*</th>\s*<td>(.*?)</td>",
            page,
            re.DOTALL,
        )
        if match:
            text = re.sub(r"<[^>]+>", "", match.group(1))
            found[key] = html.unescape(text).strip()

    return found


def main():
    parser = argparse.ArgumentParser(
        description="Scrape a Coverity Scan project page into coverity_status.json"
    )
    parser.add_argument(
        "--project", default="lustre", help="Coverity Scan project name"
    )
    parser.add_argument("--output", required=True, help="Directory to write into")
    parser.add_argument(
        "--timeout", type=int, default=30, help="HTTP timeout in seconds"
    )
    args = parser.parse_args()

    try:
        url, page = fetch_project_page(args.project, args.timeout)
    except (urllib.error.URLError, OSError) as e:
        print(
            f"Failed to fetch Coverity Scan project {args.project}: {e}",
            file=sys.stderr,
        )
        return 1

    fields = parse_fields(page)

    if "last_build_analyzed" not in fields:
        print(f"No 'Last build analyzed' row found on {url}", file=sys.stderr)
        return 1

    status = {
        "generated": int(time.time()),
        "project": args.project,
        "url": url,
        **fields,
    }

    # Write atomically so the site never reads a partial file
    status_path = os.path.join(args.output, "coverity_status.json")
    temp_path = status_path + ".tmp"

    with open(temp_path, "w") as f:
        json.dump(status, f, indent=2)
        f.write("\n")
    os.chmod(temp_path, 0o644)
    os.replace(temp_path, status_path)

    print(
        f"Coverity Scan {args.project}: last build analyzed {fields['last_build_analyzed']}"
    )
    print(f"Wrote {status_path}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
