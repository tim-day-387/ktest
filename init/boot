#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
#
# boot - hand control onward from the initramfs shell.

default_cmdline='root=/dev/lustre rw lustreroot=rootfs,device=/dev/nvme1n1p1,fsname=dd961847 module_blacklist=nouveau audit=0 drm.panic_disabled=1'

function usage() {
    cat <<EOF
Usage: boot [OPTION]... [KERNEL-IMAGE]

With no arguments, have /init mount the root named on the default cmdline
and hand off to real init.

With KERNEL-IMAGE, kexec into that UKI with the default cmdline plus
ktest.bootnow, so the new kernel boots straight through its initramfs.  A
bare name is looked up under /boot, e.g. \`boot UkImage-v16-7.1\`.  Works
from a booted system too, via systemctl kexec.

The default cmdline is:
  $default_cmdline

Options:
  -d, --device DEV       lustreroot boot device (default /dev/nvme1n1p1)
  -f, --fsname NAME      lustre fsname (default dd961847)
  -m, --module-opt K=V   replace (or append) the cmdline token with key K,
                         e.g. -m module_blacklist=nouveau,amdgpu (repeatable)
  -n, --no-exec          stage the image (kexec -l) but don't boot into it
  -h, --help             show this help
EOF
}

function die() { echo "boot: $*" >&2; exit 1; }

kernel=
no_exec=false
device=
fsname=
module_opts=()

while [[ $# -gt 0 ]]; do
    case $1 in
	-h|--help)	 usage; exit 0 ;;
	-n|--no-exec)	 no_exec=true ;;
	-d|--device)	 [[ $# -ge 2 ]] || die "$1 needs a value"; device=$2; shift ;;
	-f|--fsname)	 [[ $# -ge 2 ]] || die "$1 needs a value"; fsname=$2; shift ;;
	-m|--module-opt) [[ $# -ge 2 ]] || die "$1 needs a value"; module_opts+=("$2"); shift ;;
	-*)		 usage >&2; die "unknown option: $1" ;;
	*)		 [[ -z $kernel ]] || die "only one kernel image may be given"
			 kernel=$1 ;;
    esac
    shift
done

[[ $(id -u) -eq 0 ]] || die "must be root"

function build_cmdline() {
    local -a toks parts
    local i p opt key hit

    read -ra toks <<<"$default_cmdline"

    for i in "${!toks[@]}"; do
	[[ ${toks[i]} == lustreroot=* ]] || continue
	IFS=, read -ra parts <<<"${toks[i]#lustreroot=}"
	for p in "${!parts[@]}"; do
	    case ${parts[p]} in
		device=*) [[ -z $device ]] || parts[p]=device=$device ;;
		fsname=*) [[ -z $fsname ]] || parts[p]=fsname=$fsname ;;
	    esac
	done
	toks[i]=lustreroot=$(IFS=,; printf '%s' "${parts[*]}")
    done

    for opt in "${module_opts[@]}"; do
	key=${opt%%=*}
	hit=false
	for i in "${!toks[@]}"; do
	    [[ ${toks[i]} == "$key" || ${toks[i]} == "$key="* ]] || continue
	    toks[i]=$opt
	    hit=true
	done
	$hit || toks+=("$opt")
    done

    printf '%s' "${toks[*]}"
}

if [[ -z $kernel ]]; then
    $no_exec && die "--no-exec needs a kernel image to kexec"
    # Anywhere but the initramfs shell this would just HUP the login shell.
    [[ -x /init ]] || die "not in the ktest initramfs - pass a kernel image to kexec"

    build_cmdline > /run/ktest-boot
    echo "cmdline: $(</run/ktest-boot)"
    echo "boot armed: handing off to /init"
    kill -HUP $PPID
    exit 0
fi

[[ -e $kernel || ! -e /boot/$kernel ]] || kernel=/boot/$kernel
[[ -e $kernel ]] || die "kernel image not found: $kernel"

cmdline="$(build_cmdline) ktest.bootnow"
echo "Staging: $kernel"
echo "cmdline: $cmdline"
kexec -l "$kernel" --command-line "$cmdline" || die "kexec failed to load $kernel"

if $no_exec; then
    echo "Staged. Boot it with: kexec -e (kexec -u to cancel; systemctl kexec on a booted system)"
    exit 0
fi

# Wifi won't re-init across kexec without a hardware reset: unload the
# driver behind every wireless netdev and FLR-reset the device.
for dev in /sys/class/net/*; do
    [[ -e $dev/phy80211 && -e $dev/device/driver/module ]] || continue
    pci=$(basename "$(readlink -f "$dev/device")")
    mod=$(basename "$(readlink -f "$dev/device/driver/module")")
    echo "Unloading $mod (${dev##*/}) and resetting $pci before kexec"
    for holder in "/sys/module/$mod/holders"/*; do
	[[ -e $holder ]] && modprobe -r "${holder##*/}"
    done
    modprobe -r "$mod"
    echo 1 > "/sys/bus/pci/devices/$pci/reset"
done

echo "Booting into $kernel now..."
# Let systemd shut a booted system down cleanly; the initramfs has none.
[[ -d /run/systemd/system ]] && exec systemctl kexec
sync
exec kexec -e
